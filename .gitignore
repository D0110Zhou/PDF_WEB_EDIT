# Track only the web app and the workflow required to publish it.
/*
!/.gitignore
!/web/
!/.github/

# Keep generated files and local Windows font files out of Git.
/web/node_modules/
/web/dist/
/web/.vite/
/web/.pnpm-store/
/web/*.ttf
/web/*.otf

# Keep only the GitHub Pages workflow under .github.
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/deploy.yml
